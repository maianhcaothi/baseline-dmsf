# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Media / docs — không push
*.mp4
*.avi
*.mov
*.pdf
*.ipynb

# Runtime outputs
# mAP ground truth + write-once predictions (regenerate: make_map_labels.py).
# NB: the comment is on its own line on purpose — see the note below.
map/
*.log
*.npy
*.csv
utilization.log
utilization.md

# Machine-specific
config.yaml
setup.json
# fleet inventory for deploy.ps1 — names your machines.
# NB: gitignore has no trailing comments; a comment after a pattern becomes
# part of the pattern and the rule silently never matches.
hosts.json

# deploy.ps1 must never be able to overwrite the three files above: they are
# what makes each host itself. git cannot touch an ignored file, which is the
# whole reason the fleet updates by pull and not by copy.

# Client stdout/stderr from run_cluster.ps1
client-logs/
